#!/usr/bin/env bash
# Pre-commit guard: refuses commits that contain secrets (gitleaks) or never-public paths.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

GL=$(command -v gitleaks || true)
if [ -z "$GL" ]; then
  echo "pre-commit: gitleaks not found (brew install gitleaks); refusing to commit." >&2
  exit 1
fi
"$GL" git --pre-commit --staged --redact --no-banner --config .gitleaks.toml

# The site's data is derived from docs/results; CI fails if a commit carries one without the other.
if command -v node >/dev/null && git diff --cached --name-only | grep -qE '^(docs/results/|web/data/)'; then
  node web/scripts/sync-data.mjs >/dev/null
  if ! git diff --quiet -- web/data; then
    echo "pre-commit: web/data is out of date with docs/results; it has just been regenerated: stage it (git add web/data) and commit again." >&2
    exit 1
  fi
fi

blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(\.secrets/|(.*/)?\.env$|(.*/)?\.env\.)' | grep -Ev '(^|/)\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing never-public paths:" >&2
  echo "$blocked" >&2
  exit 1
fi
