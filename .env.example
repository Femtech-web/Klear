# Klear local configuration. `make keys` writes .env (git-ignored) with public values only.
# Scripts read these and never print secrets. Keys live in .secrets/ (git-ignored).

# NEAR testnet account Klear signs from (key: .secrets/near/<account>.json)
KEEL_NEAR_ACCOUNT=
# Testnet-only EVM key that relays and pays HyperEVM gas (key: .secrets/evm/relayer.json)
KEEL_RELAYER_ADDRESS=
# Where KeelLeg sweeps may pay (defaults to the relayer)
KEEL_PAYOUT=
# Set by `scripts/testnet/keel0.sh deploy`
KEEL_LEG=

# Mainnet partner keys, only for the privacy work (docs/privacy.md). Values stay in .env, never in git.
# NEAR Intents 1Click partner JWT (partners.near-intents.org)
NEAR_INTENTS_PARTNER_JWT=
# NEAR Intents Agent API key: the hackathon's partner dashboard (partners.demo.agentsonintents.com/dashboard);
# partners.near-intents.org does not offer this key type. Still mainnet: real funds.
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
# NEAR AI Cloud key for private (TEE) inference (cloud.near.ai, API Keys; https://cloud-api.near.ai/v1)
NEAR_AI_CLOUD_API_KEY=
